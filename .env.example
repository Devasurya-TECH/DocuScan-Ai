# Security
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example.com

# Database (Leave empty for default local SQLite database)
DATABASE_URL=postgres://docuscan:docuscan_secure_pass@localhost:5432/docuscan_db

# Celery & Redis Background Worker
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Set to True for synchronous local development without Redis running:
CELERY_ALWAYS_EAGER=True

# OCR & NLP Configuration
OCR_DEFAULT_ENGINE=easyocr
OCR_LANGUAGES=en,hi
OCR_DEVICE=cpu
